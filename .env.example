# Copy this file to .env and replace every placeholder before starting Compose.
# .env is ignored by Git and must never be committed.

REDIS_PASSWORD=replace-with-a-local-or-deployment-secret
REDIS_CACHE_ENABLED=false
REDIS_AUTH_SESSIONS_ENABLED=false
REDIS_PERMISSION_CACHE_ENABLED=false
REDIS_PREVIEW_SESSIONS_ENABLED=false
REDIS_RATE_LIMITING_ENABLED=false
REDIS_IDEMPOTENCY_ENABLED=false
REDIS_DISTRIBUTED_LOCKS_ENABLED=false

# Optional resource overrides for the production Redis container.
REDIS_CONTAINER_MEMORY_LIMIT=512m
REDIS_MAXMEMORY=384mb
REDIS_CPUS=0.50
